{
  "name": "fnote",
  "displayName": "fnote",
  "icon": "media/icon.png",
  "description": "Organize Markdown notes with hierarchies and tags.",
  "version": "0.1.0",
  "publisher": "maoren",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "npm run build && node --test",
    "check": "tsc -p . --noEmit && node --check media/notes.js",
    "package": "npm run build && python3 scripts/package.py",
    "vscode:prepublish": "npm run build",
    "package:marketplace": "node -e \"require('node:fs').mkdirSync('artifacts',{recursive:true})\" && vsce package --no-dependencies --skip-license --githubBranch main --out artifacts/fnote.vsix"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "fnote.notes",
          "name": "fnote - list",
          "contextualTitle": "fnote - list",
          "icon": "$(notebook)",
          "type": "webview"
        },
        {
          "id": "fnote.tags",
          "type": "webview",
          "name": "fnote - tags",
          "contextualTitle": "fnote - tags",
          "icon": "$(tag)"
        }
      ]
    },
    "commands": [
      {
        "command": "fnote.add",
        "title": "fnote: Add Note",
        "icon": "$(add)"
      },
      {
        "command": "fnote.addChild",
        "title": "fnote: Add Child Note",
        "icon": "$(new-file)"
      },
      {
        "command": "fnote.rename",
        "title": "fnote: Rename"
      },
      {
        "command": "fnote.move",
        "title": "fnote: Move"
      },
      {
        "command": "fnote.up",
        "title": "fnote: Move Up"
      },
      {
        "command": "fnote.down",
        "title": "fnote: Move Down"
      },
      {
        "command": "fnote.delete",
        "title": "fnote: Delete",
        "icon": "$(trash)"
      },
      {
        "command": "fnote.refresh",
        "title": "fnote: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "fnote.search",
        "title": "fnote: Search Notes",
        "icon": "$(search)"
      },
      {
        "command": "fnote.collapseNotes",
        "title": "fnote: Collapse All Notes",
        "icon": "$(collapse-all)",
        "enablement": "fnote.notesHasBranches"
      },
      {
        "command": "fnote.collapseTags",
        "title": "fnote: Collapse All Tags",
        "icon": "$(collapse-all)",
        "enablement": "fnote.tagsHasBranches"
      },
      {
        "command": "fnote.expandNotes",
        "title": "fnote: Expand All Notes",
        "icon": "$(expand-all)",
        "enablement": "fnote.notesAllCollapsed && fnote.notesHasBranches"
      },
      {
        "command": "fnote.expandTags",
        "title": "fnote: Expand All Tags",
        "icon": "$(expand-all)",
        "enablement": "fnote.tagsAllCollapsed && fnote.tagsHasBranches"
      },
      {
        "command": "fnote.closeAllNotes",
        "title": "fnote: Close All Open Notes",
        "icon": "$(close-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "fnote.add",
          "when": "view == fnote.notes",
          "group": "navigation@1"
        },
        {
          "command": "fnote.refresh",
          "when": "view == fnote.notes || view == fnote.tags",
          "group": "navigation@2"
        },
        {
          "command": "fnote.search",
          "when": "view == fnote.notes",
          "group": "navigation@0"
        },
        {
          "command": "fnote.collapseNotes",
          "when": "view == fnote.notes && !fnote.notesAllCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "fnote.collapseTags",
          "when": "view == fnote.tags && !fnote.tagsAllCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "fnote.expandNotes",
          "when": "view == fnote.notes && fnote.notesAllCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "fnote.expandTags",
          "when": "view == fnote.tags && fnote.tagsAllCollapsed",
          "group": "navigation@3"
        },
        {
          "command": "fnote.closeAllNotes",
          "when": "view == fnote.notes",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "fnote",
      "properties": {
        "fnote.storagePath": {
          "type": "string",
          "default": "~/.fnote",
          "scope": "machine",
          "description": "Shared note storage for all workspaces. Set an absolute path or a path starting with ~/ in user settings. An empty string uses the extension storage location. Reload the window after changing this setting. Existing notes are not moved automatically."
        },
        "fnote.untaggedNoteMark": {
          "type": "string",
          "default": "$(note)",
          "description": "Icon for notes without an eligible tag. Use a Codicon such as $(note), text, or an emoji. An empty string hides the icon."
        },
        "fnote.defaultTagMark": {
          "type": "string",
          "default": "$(circle-filled-compact)",
          "description": "Default tag icon. Use a Codicon such as $(circle-filled-compact), text, or an emoji. An empty string hides the icon."
        },
        "fnote.tagColor": {
          "type": "string",
          "default": "#00BFFF",
          "description": "Default tag text color.",
          "format": "color"
        },
        "fnote.tagStyles": {
          "type": [
            "array",
            "object"
          ],
          "default": [
            {
              "tag": "FIX",
              "mark": "$(bug)",
              "color": "#f87171"
            },
            {
              "tag": "TODO",
              "mark": "$(circle-filled-compact)",
              "color": "#f87171"
            },
            {
              "tag": "date",
              "mark": "$(calendar)",
              "excludeFromNoteMark": true
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "minLength": 1
              },
              "mark": {
                "type": "string",
                "description": "Text, an emoji, or a Codicon such as $(circle-filled-compact)."
              },
              "color": {
                "type": "string",
                "format": "color"
              },
              "backgroundColor": {
                "type": "string",
                "description": "Background color for this tag. An empty string means no background color.",
                "format": "color"
              },
              "excludeFromNoteMark": {
                "type": "boolean",
                "default": false,
                "description": "Exclude this tag when choosing and prioritizing note icons. Child tags inherit this setting and can override it with false. Icons and colors in the tag list are unaffected."
              },
              "markColor": {
                "type": "string",
                "format": "color",
                "description": "Codicon color. Falls back to color, then to an HSL color generated from the tag name. Does not change emoji colors."
              }
            },
            "additionalProperties": false
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mark": {
                "type": "string",
                "description": "Text, an emoji, or a Codicon such as $(circle-filled-compact)."
              },
              "color": {
                "type": "string",
                "format": "color"
              },
              "backgroundColor": {
                "type": "string",
                "format": "color"
              },
              "excludeFromNoteMark": {
                "type": "boolean",
                "default": false,
                "description": "Exclude this tag when choosing and prioritizing note icons. Child tags inherit this setting and can override it with false. Icons and colors in the tag list are unaffected."
              },
              "markColor": {
                "type": "string",
                "format": "color",
                "description": "Codicon color. Falls back to color, then to an HSL color generated from the tag name. Does not change emoji colors."
              }
            },
            "additionalProperties": false
          },
          "description": "Tags defined earlier have higher priority when choosing note icons. Each array entry accepts tag (without @), mark, markColor, color, backgroundColor, and excludeFromNoteMark. Parent settings apply to child tags. Use tag: \"date\" for shared year, month, and day defaults; year-specific settings take priority. The legacy object format is also supported. Use the array format to preserve priority for numeric tag names."
        },
        "fnote.tagBackgroundColor": {
          "type": "string",
          "default": "",
          "description": "Default tag background color in the editor and search results. An empty string means no background color.",
          "format": "color"
        },
        "fnote.tagHierarchy": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "description": "Define parent and child tags without @, for example {\"toyota\": [\"land-cruiser\", \"rav4\"]}. Tags in note content are unchanged. Selecting a parent shows matches from its descendants. If a tag has multiple parents, the first definition wins. Cyclic definitions are ignored."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "fnote.notes",
        "contents": "Start taking notes in Markdown.\n[Add Note](command:fnote.add)"
      },
      {
        "view": "fnote.tags",
        "contents": "Add @TODO or @2026/09/01 to your notes to see tags here."
      }
    ]
  },
  "devDependencies": {
    "@types/node": "20.17.19",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahoutsukaino-deshi/fnote.git"
  }
}
